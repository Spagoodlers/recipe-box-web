  {
   "id": "starter-sauces-and-staples-banana-bread",
   "title": "Banana Bread",
   "description": "",
   "ingredients": [
    "3 ripe bananas, mashed",
    "⅓ cup melted butter",
    "¾ cup sugar",
    "1 egg, beaten",
    "1 tsp vanilla",
    "1 tsp baking soda",
    "pinch of salt",
    "1½ cups flour"
   ],
   "steps": [
    "Heat the oven to 350°F. Grease a loaf pan.",
    "Mix the bananas and butter.",
    "Stir in the sugar, egg and vanilla.",
    "Sprinkle in the baking soda and salt, then stir in the flour.",
    "Pour into the pan. Bake for 60 minutes, until a skewer comes out clean.",
    "Cool in the pan for 10 minutes."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 220",
    "Protein: 3 g",
    "Fat: 7 g",
    "Carbohydrate: 37 g",
    "Fiber: 1 g",
