   "id": "starter-sauces-and-staples-yogurt-flatbread",
   "title": "Yogurt Flatbread",
   "description": "",
   "ingredients": [
    "2 cups flour",
    "1 tsp baking powder",
    "½ tsp salt",
    "¾ cup plain yogurt"
   ],
   "steps": [
    "Mix everything into a soft dough. Knead for 1 minute.",
    "Split into 6 pieces and roll each one thin.",
    "Cook in a hot dry pan for 2 minutes per side, until puffed and spotted brown."
   ],
   "notes": "",
