   "id": "starter-sauces-and-staples-chicken-stock",
   "title": "Chicken Stock",
   "description": "",
   "ingredients": [
    "1 roast chicken carcass",
    "1 onion, halved",
    "2 carrots",
    "2 celery sticks",
    "1 bay leaf",
    "10 peppercorns",
    "10 cups water"
   ],
   "steps": [
    "Put everything in a big pot. Bring to a boil.",
    "Turn down and simmer gently for 3 hours, skimming off any foam.",
    "Strain and cool. Keeps 4 days in the fridge or months in the freezer."
   ],
