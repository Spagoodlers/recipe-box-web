   "id": "starter-sauces-and-staples-cheese-sauce",
   "title": "Cheese Sauce",
   "description": "",
   "ingredients": [
    "2 tbsp butter",
    "2 tbsp flour",
    "1½ cups milk",
    "1 cup grated cheddar",
    "½ tsp mustard",
    "salt"
   ],
   "steps": [
    "Melt the butter in a pan. Stir in the flour and cook for 1 minute.",
    "Slowly whisk in the milk. Simmer for 3 minutes, until thick.",
    "Off the heat, stir in the cheese and mustard. Season."
   ],
   "notes": "",
