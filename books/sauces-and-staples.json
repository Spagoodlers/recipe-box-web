   "id": "starter-sauces-and-staples-pancakes",
   "title": "Pancakes",
   "description": "",
   "ingredients": [
    "1 cup flour",
    "1 tbsp sugar",
    "2 tsp baking powder",
    "¼ tsp salt",
    "1 cup milk",
    "1 egg",
    "2 tbsp melted butter"
   ],
   "steps": [
    "Whisk the flour, sugar, baking powder and salt in a bowl.",
    "Whisk the milk, egg and butter in another.",
    "Pour the wet into the dry and stir just until mixed. Lumps are fine.",
    "Heat a lightly oiled pan over medium heat. Pour in ¼ cup of batter per pancake.",
    "Cook until bubbles pop on top, about 2 minutes. Flip and cook 1 minute more."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 120",
    "Protein: 3 g",
