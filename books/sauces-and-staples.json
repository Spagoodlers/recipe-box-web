  {
   "id": "starter-sauces-and-staples-pizza-dough",
   "title": "Pizza Dough",
   "description": "",
   "ingredients": [
    "3 cups flour",
    "1 tsp instant yeast",
    "1 tsp salt",
    "1 cup warm water",
    "2 tbsp olive oil"
   ],
   "steps": [
    "Mix everything into a dough. Knead for 8 minutes, until smooth.",
    "Put in an oiled bowl, cover and leave to rise for 60 minutes, until doubled.",
    "Heat the oven to 475°F. Split the dough in two and stretch each piece thin.",
    "Add toppings and bake for 12 minutes, until the edges are brown."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 800",
