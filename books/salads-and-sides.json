  {
   "id": "starter-salads-and-sides-caesar-salad",
   "title": "Caesar Salad",
   "description": "",
   "ingredients": [
    "1 large romaine lettuce",
    "2 cups bread cubes",
    "2 tbsp olive oil",
    "## Dressing",
    "1 clove garlic, grated",
    "2 anchovy fillets, mashed",
    "1 egg yolk",
    "1 tbsp lemon juice",
    "1 tsp Dijon mustard",
    "⅓ cup olive oil",
    "½ cup grated Parmesan"
   ],
   "steps": [
    "Heat the oven to 400°F. Toss the bread with the oil and bake for 10 minutes, until crisp.",
    "Whisk the garlic, anchovies, yolk, lemon and mustard. Whisk in the oil slowly, then half the Parmesan.",
    "Tear the lettuce. Toss with the dressing, croutons and the rest of the Parmesan."
   ],
   "notes": "",
