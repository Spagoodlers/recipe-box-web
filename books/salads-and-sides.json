  {
   "id": "starter-salads-and-sides-mashed-potatoes",
   "title": "Mashed Potatoes",
   "description": "",
   "ingredients": [
    "3 lb floury potatoes, peeled and in chunks",
    "½ cup butter",
    "¾ cup warm milk",
    "1 tsp salt",
    "white pepper"
   ],
   "steps": [
    "Put the potatoes in cold salted water. Bring to a boil and cook for 20 minutes, until soft.",
    "Drain well and let steam dry for 2 minutes.",
    "Mash with the butter, then beat in the milk. Season with salt and pepper."
   ],
   "notes": "",
