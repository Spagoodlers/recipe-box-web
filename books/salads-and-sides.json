   "id": "starter-salads-and-sides-potato-salad",
   "title": "Potato Salad",
   "description": "",
   "ingredients": [
    "2 lb waxy potatoes, in chunks",
    "½ cup mayonnaise",
    "1 tbsp Dijon mustard",
    "2 celery sticks, diced",
    "3 green onions, sliced",
    "2 hard-boiled eggs, chopped",
    "1 tsp salt",
    "black pepper"
   ],
   "steps": [
    "Boil the potatoes in salted water for 15 minutes, until just tender. Drain and cool.",
    "Mix the mayonnaise and mustard.",
    "Fold in the potatoes, celery, green onions and eggs. Season with salt and pepper."
   ],
   "notes": "",
