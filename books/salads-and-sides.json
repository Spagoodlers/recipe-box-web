   "id": "starter-salads-and-sides-classic-coleslaw",
   "title": "Classic Coleslaw",
   "description": "",
   "ingredients": [
    "½ head green cabbage, shredded",
    "2 carrots, grated",
    "½ cup mayonnaise",
    "1 tbsp cider vinegar",
    "1 tsp sugar",
    "½ tsp salt",
    "black pepper"
   ],
   "steps": [
    "Mix the mayonnaise, vinegar, sugar, salt and pepper.",
    "Toss with the cabbage and carrots.",
    "Chill for 30 minutes before serving."
