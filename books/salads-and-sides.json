  {
   "id": "starter-salads-and-sides-roast-vegetables",
   "title": "Roast Vegetables",
   "description": "",
   "ingredients": [
    "2 lb mixed vegetables (carrots, parsnips, squash, onions)",
    "3 tbsp olive oil",
    "1 tsp salt",
    "½ tsp black pepper",
    "a few sprigs rosemary or thyme"
   ],
   "steps": [
    "Heat the oven to 425°F.",
    "Cut the vegetables into even chunks. Toss with the oil, salt, pepper and herbs.",
    "Spread on a tray in one layer.",
    "Roast for 40 minutes, turning once, until browned at the edges."
   ],
   "notes": "",
