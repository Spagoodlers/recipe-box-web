  {
   "id": "starter-salads-and-sides-rice-pilaf",
   "title": "Rice Pilaf",
   "description": "",
   "ingredients": [
    "1 cup long-grain rice",
    "2 tbsp butter",
    "1 small onion, finely chopped",
    "2 cups chicken or vegetable stock",
    "½ tsp salt",
    "2 tbsp chopped parsley"
   ],
   "steps": [
    "Melt the butter in a pan. Cook the onion for 3 minutes.",
    "Add the rice and stir for 2 minutes, until it smells toasty.",
    "Add the stock and salt. Bring to a boil, cover and cook on low for 18 minutes.",
    "Rest, covered, for 5 minutes. Fluff with a fork and stir in the parsley."
   ],
   "notes": "",
