   "id": "starter-salads-and-sides-green-beans-with-garlic",
   "title": "Green Beans with Garlic",
   "description": "",
   "ingredients": [
    "1 lb green beans, trimmed",
    "2 tbsp butter",
    "2 cloves garlic, sliced",
    "salt",
    "1 tsp lemon juice"
   ],
   "steps": [
    "Boil the beans in salted water for 4 minutes. Drain.",
