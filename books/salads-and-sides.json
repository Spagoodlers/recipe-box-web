  {
   "id": "starter-salads-and-sides-greek-salad",
   "title": "Greek Salad",
   "description": "",
   "ingredients": [
    "4 tomatoes, in wedges",
    "1 cucumber, in chunks",
    "1 green pepper, sliced",
    "½ red onion, thinly sliced",
    "½ cup Kalamata olives",
    "7 oz feta, in a block",
    "3 tbsp olive oil",
    "1 tbsp red wine vinegar",
    "1 tsp dried oregano"
   ],
   "steps": [
    "Put the tomatoes, cucumber, pepper, onion and olives in a bowl.",
    "Lay the feta on top.",
    "Drizzle with the oil and vinegar. Sprinkle with oregano."
   ],
