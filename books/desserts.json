  {
   "id": "starter-desserts-panna-cotta",
   "title": "Panna Cotta",
   "description": "",
   "ingredients": [
    "2½ tsp powdered gelatin",
    "3 tbsp cold water",
    "2 cups heavy cream",
    "1 cup whole milk",
    "½ cup sugar",
    "1 tsp vanilla extract",
    "berries, to serve"
   ],
   "steps": [
    "Sprinkle the gelatin over the cold water and leave for 5 minutes.",
    "Warm the cream, milk and sugar until steaming. Do not boil.",
    "Take off the heat. Stir in the gelatin until dissolved, then the vanilla.",
    "Pour into 6 glasses or ramekins. Chill for 4 hours, until set.",
    "Serve with berries."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 360",
    "Protein: 5 g",
    "Fat: 30 g",
    "Carbohydrate: 21 g",
