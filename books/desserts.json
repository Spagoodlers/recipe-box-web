  {
   "id": "starter-desserts-bread-pudding",
   "title": "Bread Pudding",
   "description": "",
   "ingredients": [
    "6 cups day-old bread, in cubes",
    "3 eggs",
    "2 cups milk",
    "½ cup sugar",
    "2 tbsp butter, melted",
    "1 tsp cinnamon",
    "1 tsp vanilla extract",
    "½ cup raisins"
   ],
   "steps": [
    "Heat the oven to 350°F. Butter a baking dish.",
    "Put the bread and raisins in the dish.",
    "Whisk the eggs, milk, sugar, butter, cinnamon and vanilla. Pour over the bread.",
    "Press the bread down and leave to soak for 10 minutes.",
    "Bake for 45 minutes, until puffed and set in the middle."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 300",
    "Protein: 9 g",
