  {
   "id": "starter-desserts-no-bake-cheesecake",
   "title": "No-Bake Cheesecake",
   "description": "",
   "ingredients": [
    "## Base",
    "1½ cups graham cracker crumbs",
    "6 tbsp butter, melted",
    "## Filling",
    "16 oz cream cheese, softened",
    "½ cup powdered sugar",
    "1 tsp vanilla extract",
    "1 tbsp lemon juice",
    "1 cup heavy cream"
   ],
   "steps": [
    "Mix the crumbs and butter. Press into a 9-inch pan.",
    "Beat the cream cheese, powdered sugar, vanilla and lemon juice until smooth.",
    "Whip the cream to stiff peaks and fold it in.",
    "Spread the filling over the base. Chill for 6 hours, until firm."
   ],
