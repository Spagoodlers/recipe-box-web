  {
   "id": "starter-desserts-peach-cobbler",
   "title": "Peach Cobbler",
   "description": "",
   "ingredients": [
    "6 cups sliced peaches (fresh or frozen)",
    "½ cup sugar",
    "1 tbsp cornstarch",
    "1 tsp cinnamon",
    "## Topping",
    "1 cup flour",
    "¼ cup sugar",
    "1½ tsp baking powder",
    "½ tsp salt",
    "4 tbsp cold butter",
    "½ cup milk"
   ],
   "steps": [
    "Heat the oven to 375°F.",
    "Toss the peaches with the sugar, cornstarch and cinnamon. Spread in a baking dish.",
    "Mix the flour, sugar, baking powder and salt. Rub in the butter, then stir in the milk.",
    "Drop spoonfuls of the topping over the peaches.",
    "Bake for 45 minutes, until golden and bubbling."
   ],
   "notes": "",
