  {
   "id": "starter-desserts-lemon-bars",
   "title": "Lemon Bars",
   "description": "",
   "ingredients": [
    "## Base",
    "1 cup flour",
    "½ cup butter, softened",
    "¼ cup powdered sugar",
    "## Filling",
    "2 eggs",
    "1 cup sugar",
    "2 tbsp flour",
    "⅓ cup lemon juice",
    "1 tbsp lemon zest"
   ],
   "steps": [
    "Heat the oven to 350°F. Line an 8-inch square pan.",
    "Mix the base ingredients into a dough and press into the pan.",
    "Bake the base for 20 minutes, until pale gold.",
    "Whisk the filling ingredients together and pour over the hot base.",
    "Bake for 25 minutes, until just set.",
    "Cool, then chill before cutting into 16 squares. Dust with powdered sugar."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 150",
    "Protein: 2 g",
