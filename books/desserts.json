  {
   "id": "starter-desserts-rice-pudding",
   "title": "Rice Pudding",
   "description": "",
   "ingredients": [
    "½ cup short-grain rice",
    "4 cups whole milk",
    "⅓ cup sugar",
    "pinch of salt",
    "1 tsp vanilla extract",
    "nutmeg or cinnamon, to serve"
   ],
   "steps": [
    "Put the rice, milk, sugar and salt in a heavy pan. Bring to a simmer, stirring.",
    "Cook on the lowest heat for 40 minutes, stirring often, until thick and creamy.",
    "Stir in the vanilla. Serve warm or cold, dusted with nutmeg or cinnamon."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 300",
    "Protein: 9 g",
    "Fat: 8 g",
