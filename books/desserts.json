  {
   "id": "starter-desserts-apple-crumble",
   "title": "Apple Crumble",
   "description": "",
   "ingredients": [
    "6 apples, peeled and sliced",
    "2 tbsp sugar",
    "1 tsp cinnamon",
    "1 tbsp lemon juice",
    "## Topping",
    "1 cup flour",
    "½ cup brown sugar",
    "½ cup rolled oats",
    "½ cup cold butter, cubed",
    "pinch of salt"
   ],
   "steps": [
    "Heat the oven to 375°F.",
    "Toss the apples with the sugar, cinnamon and lemon juice. Spread in a baking dish.",
    "Rub the flour, brown sugar, oats, butter and salt together until it looks like rough crumbs.",
    "Scatter the topping over the apples.",
    "Bake for 40 minutes, until golden and bubbling at the edges."
   ],
   "notes": "",
