  {
   "id": "starter-desserts-baked-apples",
   "title": "Baked Apples",
   "description": "",
   "ingredients": [
    "4 baking apples",
    "¼ cup brown sugar",
    "¼ cup chopped walnuts",
    "¼ cup raisins",
    "1 tsp cinnamon",
    "2 tbsp butter",
    "½ cup water"
   ],
   "steps": [
    "Heat the oven to 350°F.",
    "Core the apples, leaving the bottoms whole.",
    "Mix the sugar, walnuts, raisins and cinnamon. Pack into the apples and top each with butter.",
    "Stand in a dish with the water. Bake for 40 minutes, until tender."
   ],
