  {
   "id": "starter-desserts-chocolate-mousse",
   "title": "Chocolate Mousse",
   "description": "",
   "ingredients": [
    "6 oz dark chocolate, chopped",
    "3 eggs, separated",
    "2 tbsp sugar",
    "1 cup heavy cream",
    "pinch of salt"
   ],
   "steps": [
    "Melt the chocolate in a bowl over a pan of simmering water. Let it cool for 5 minutes.",
    "Stir the egg yolks into the chocolate one at a time.",
    "Whip the cream to soft peaks.",
    "In a clean bowl, whisk the egg whites and salt to soft peaks, then whisk in the sugar until glossy.",
    "Fold the cream into the chocolate, then fold in the whites gently.",
    "Spoon into glasses. Chill for 4 hours."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 510",
    "Protein: 9 g",
    "Fat: 39 g",
    "Carbohydrate: 30 g",
    "Fiber: 3 g",
