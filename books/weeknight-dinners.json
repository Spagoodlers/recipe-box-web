  {
   "id": "starter-weeknight-dinners-egg-fried-rice",
   "title": "Egg Fried Rice",
   "description": "",
   "ingredients": [
    "2 cups cold cooked rice",
    "2 eggs, beaten",
    "1 tbsp oil",
    "1 cup frozen peas and carrots",
    "2 spring onions, sliced",
    "2 tbsp soy sauce",
    "1 tsp sesame oil"
   ],
   "steps": [
    "Heat the oil in a large pan over high heat.",
    "Fry the peas and carrots for 2 minutes.",
    "Push them aside and scramble the eggs in the space.",
    "Add the rice and stir-fry for 4 minutes, until hot.",
    "Add the soy sauce, sesame oil and spring onions."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 400",
    "Protein: 13 g",
    "Fat: 15 g",
