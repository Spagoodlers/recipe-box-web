  {
   "id": "starter-weeknight-dinners-shakshuka",
   "title": "Shakshuka",
   "description": "",
   "ingredients": [
    "1 tbsp olive oil",
    "1 onion, sliced",
    "1 red bell pepper, sliced",
    "2 cloves garlic",
    "1 tsp ground cumin",
    "1 tsp paprika",
    "1 can (14 oz) chopped tomatoes",
    "4 eggs",
    "salt",
    "bread, to serve"
   ],
   "steps": [
    "Soften the onion and pepper in the oil for 5 minutes.",
    "Add the garlic and spices for 1 minute.",
    "Add the tomatoes and simmer for 10 minutes. Season.",
    "Make 4 wells and crack an egg into each.",
    "Cover and cook for 6 minutes, until the whites are set. Serve with bread."
   ],
   "notes": "",
   "nutrition": [
