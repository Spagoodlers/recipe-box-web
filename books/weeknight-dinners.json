  {
   "id": "starter-weeknight-dinners-sheet-pan-sausages-and-vegetables",
   "title": "Sheet-Pan Sausages and Vegetables",
   "description": "",
   "ingredients": [
    "6 sausages",
    "1 lb baby potatoes, halved",
    "1 red onion, in wedges",
    "2 bell peppers, in chunks",
    "2 tbsp olive oil",
    "1 tsp paprika",
    "salt and pepper"
   ],
   "steps": [
    "Heat the oven to 425°F.",
    "Toss the potatoes with half the oil on a sheet pan. Roast for 15 minutes.",
    "Add the sausages, onion, peppers, the rest of the oil and the paprika. Season.",
    "Roast 25 minutes more, turning once, until the sausages are cooked through."
   ],
   "notes": "",
   "nutrition": [
