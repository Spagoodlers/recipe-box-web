  {
   "id": "starter-weeknight-dinners-teriyaki-salmon",
   "title": "Teriyaki Salmon",
   "description": "",
   "ingredients": [
    "2 salmon fillets",
    "1 tsp oil",
    "3 tbsp soy sauce",
    "1 tbsp honey",
    "1 tsp grated ginger",
    "1 clove garlic, minced",
    "rice, to serve"
   ],
   "steps": [
    "Mix the soy sauce, honey, ginger and garlic.",
    "Cook the salmon skin-side down in the oil over medium-high heat for 4 minutes.",
    "Flip and cook 3 minutes more.",
    "Pour in the sauce and let it bubble for 1 minute, spooning it over until glossy.",
    "Serve with rice."
   ],
   "notes": "",
