   "id": "starter-weeknight-dinners-fish-tacos",
   "title": "Fish Tacos",
   "description": "",
   "ingredients": [
    "1 lb white fish fillets",
    "1 tsp chili powder",
    "½ tsp ground cumin",
    "½ tsp salt",
    "1 tbsp oil",
    "8 small tortillas",
    "2 cups shredded cabbage",
    "½ cup sour cream",
    "1 lime, in wedges"
   ],
   "steps": [
    "Season the fish with the chili powder, cumin and salt.",
    "Cook in the oil over medium-high heat for 3 minutes per side, until it flakes.",
    "Warm the tortillas.",
    "Flake the fish into the tortillas. Top with cabbage, sour cream and a squeeze of lime."
   ],
   "notes": "",
