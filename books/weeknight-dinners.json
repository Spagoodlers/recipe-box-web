  {
   "id": "starter-weeknight-dinners-chicken-stir-fry",
   "title": "Chicken Stir-Fry",
   "description": "",
   "ingredients": [
    "2 chicken breasts, thinly sliced",
    "1 tbsp oil",
    "1 bell pepper, sliced",
    "1 cup broccoli florets",
    "2 cloves garlic, minced",
    "1 tbsp grated ginger",
    "3 tbsp soy sauce",
    "1 tbsp honey",
    "1 tsp cornstarch mixed with 2 tbsp water",
    "rice, to serve"
   ],
   "steps": [
    "Heat the oil in a large pan over high heat.",
    "Cook the chicken for 5 minutes, until browned and cooked through. Lift it out.",
    "Stir-fry the pepper and broccoli for 3 minutes.",
    "Add the garlic and ginger for 30 seconds.",
    "Return the chicken. Add the soy sauce, honey and cornstarch mix. Toss for 1 minute until glossy.",
    "Serve over rice."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 380",
    "Protein: 49 g",
    "Fat: 12 g",
    "Carbohydrate: 17 g",
    "Fiber: 2 g",
    "Sugar: 12 g",
    "Sodium: 1420 mg"
   ],
   "servings": 2,
