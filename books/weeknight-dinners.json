  {
   "id": "starter-weeknight-dinners-beef-chili",
   "title": "Beef Chili",
   "description": "",
   "ingredients": [
    "1 lb ground beef",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "1 tbsp chili powder",
    "1 tsp ground cumin",
    "1 can (14 oz) chopped tomatoes",
    "1 can (14 oz) kidney beans, drained",
    "1 cup beef stock",
    "salt"
   ],
   "steps": [
    "Brown the beef in a large pot for 5 minutes, until no pink remains. Spoon off excess fat.",
    "Add the onion and garlic and cook for 5 minutes.",
    "Stir in the chili powder and cumin for 1 minute.",
    "Add the tomatoes, beans and stock.",
    "Simmer for 30 minutes, stirring now and then. Season. Serve with rice, sour cream or cheese."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 410",
    "Protein: 26 g",
    "Fat: 23 g",
