  {
   "id": "starter-weeknight-dinners-tomato-soup",
   "title": "Tomato Soup",
   "description": "",
   "ingredients": [
    "2 tbsp butter",
    "1 onion, chopped",
    "2 cloves garlic",
    "1 can (28 oz) whole tomatoes",
    "2 cups stock",
    "1 tsp sugar",
    "½ cup cream (optional)",
    "salt and pepper"
   ],
   "steps": [
    "Melt the butter and soften the onion for 5 minutes. Add the garlic for 1 minute.",
    "Add the tomatoes, stock and sugar. Simmer for 20 minutes.",
    "Blend until smooth.",
    "Stir in the cream and season."
   ],
   "notes": "",
