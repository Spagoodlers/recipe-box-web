  {
   "id": "starter-weeknight-dinners-spaghetti-aglio-e-olio",
   "title": "Spaghetti Aglio e Olio",
   "description": "",
   "ingredients": [
    "8 oz spaghetti",
    "⅓ cup olive oil",
    "4 cloves garlic, thinly sliced",
    "½ tsp chili flakes",
    "a handful of parsley, chopped",
    "salt",
    "parmesan, to serve"
   ],
   "steps": [
    "Cook the spaghetti in well-salted boiling water. Save a cup of the water before draining.",
    "Meanwhile, warm the oil and garlic over low heat for 5 minutes, until the garlic is pale gold.",
    "Stir in the chili flakes.",
    "Toss the drained pasta in the pan with a splash of pasta water and the parsley.",
    "Season and serve with parmesan."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 760",
    "Protein: 16 g",
    "Fat: 38 g",
