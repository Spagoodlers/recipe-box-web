  {
   "id": "starter-baking-basics-sugar-cookies",
   "title": "Sugar Cookies",
   "description": "",
   "ingredients": [
    "1 cup butter, softened",
    "1 cup sugar",
    "1 egg",
    "1 tsp vanilla",
    "2½ cups flour",
    "1 tsp baking powder",
    "¼ tsp salt"
   ],
   "steps": [
    "Heat the oven to 375°F.",
    "Beat the butter and sugar. Beat in the egg and vanilla.",
    "Stir in the flour, baking powder and salt.",
    "Roll into 1-inch balls and flatten slightly on sheets.",
    "Bake for 9 minutes, until the edges are barely golden."
   ],
   "notes": "",
