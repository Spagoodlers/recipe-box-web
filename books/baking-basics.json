  {
   "id": "starter-baking-basics-scones",
   "title": "Scones",
   "description": "",
   "ingredients": [
    "2 cups flour",
    "¼ cup sugar",
    "1 tbsp baking powder",
    "½ tsp salt",
    "½ cup cold butter, cubed",
    "⅔ cup milk",
    "1 egg"
   ],
   "steps": [
    "Heat the oven to 425°F.",
    "Rub the butter into the flour, sugar, baking powder and salt.",
    "Stir in the milk and egg to make a soft dough.",
    "Pat into a 1-inch-thick circle and cut into 8 wedges.",
    "Bake for 15 minutes, until golden."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 260",
    "Protein: 5 g",
    "Fat: 13 g",
    "Carbohydrate: 32 g",
    "Fiber: 1 g",
