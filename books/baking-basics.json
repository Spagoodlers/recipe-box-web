  {
   "id": "starter-baking-basics-pie-crust",
   "title": "Pie Crust",
   "description": "",
   "ingredients": [
    "1¼ cups flour",
    "½ tsp salt",
    "½ cup cold butter, cubed",
    "4 tbsp ice water"
   ],
   "steps": [
    "Rub the butter into the flour and salt until it looks like crumbs with pea-sized bits.",
    "Add the water a spoonful at a time, just until it holds together.",
    "Shape into a disk, wrap and chill for 30 minutes.",
    "Roll out on a floured surface to fit your pie dish."
   ],
