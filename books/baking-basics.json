   "id": "starter-baking-basics-shortbread",
   "title": "Shortbread",
   "description": "",
   "ingredients": [
    "1 cup butter, softened",
    "½ cup sugar",
    "2 cups flour",
    "pinch of salt"
   ],
   "steps": [
    "Heat the oven to 325°F.",
    "Beat the butter and sugar. Work in the flour and salt.",
    "Press into an 8-inch square pan and prick all over with a fork.",
    "Bake for 30 minutes, until pale gold.",
    "Cut into pieces while warm. Cool in the pan."
   ],
