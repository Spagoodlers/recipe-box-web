  {
   "id": "starter-baking-basics-blueberry-muffins",
   "title": "Blueberry Muffins",
   "description": "",
   "ingredients": [
    "2 cups flour",
    "¾ cup sugar",
    "2 tsp baking powder",
    "½ tsp salt",
    "⅓ cup oil",
    "1 egg",
    "¾ cup milk",
    "1 tsp vanilla",
    "1 cup blueberries"
   ],
   "steps": [
    "Heat the oven to 400°F. Line a muffin tin.",
    "Whisk the flour, sugar, baking powder and salt.",
    "Whisk the oil, egg, milk and vanilla in another bowl.",
    "Stir the wet into the dry until just mixed. Fold in the blueberries.",
    "Fill the cups two-thirds full. Bake for 20 minutes."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 200",
    "Protein: 3 g",
    "Fat: 7 g",
    "Carbohydrate: 31 g",
    "Fiber: 1 g",
    "Sugar: 15 g",
