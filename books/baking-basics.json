   "id": "starter-baking-basics-cornbread",
   "title": "Cornbread",
   "description": "",
   "ingredients": [
    "1 cup cornmeal",
    "1 cup flour",
    "¼ cup sugar",
    "1 tbsp baking powder",
    "½ tsp salt",
    "1 cup milk",
    "1 egg",
    "⅓ cup melted butter"
   ],
   "steps": [
    "Heat the oven to 400°F. Grease an 8-inch square pan.",
    "Mix the dry ingredients. Mix the wet ones separately.",
    "Stir together until just combined.",
    "Pour into the pan and bake for 22 minutes, until golden."
   ],
