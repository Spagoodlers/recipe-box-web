  {
   "id": "starter-baking-basics-vanilla-cake",
   "title": "Vanilla Cake",
   "description": "",
   "ingredients": [
    "2 cups flour",
    "1½ cups sugar",
    "1 tbsp baking powder",
    "½ tsp salt",
    "½ cup butter, softened",
    "1 cup milk",
    "3 eggs",
    "2 tsp vanilla"
   ],
   "steps": [
    "Heat the oven to 350°F. Grease two 8-inch round pans.",
    "Mix the flour, sugar, baking powder and salt. Beat in the butter until sandy.",
    "Add the milk, eggs and vanilla. Beat for 2 minutes.",
    "Divide between the pans. Bake for 30 minutes, until a skewer comes out clean.",
    "Cool in the pans for 10 minutes, then turn out."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 270",
    "Protein: 4 g",
    "Fat: 10 g",
    "Carbohydrate: 42 g",
    "Fiber: 1 g",
    "Sugar: 26 g",
    "Sodium: 270 mg"
   ],
   "servings": 12,
   "yieldText": "one 2-layer cake",
   "prepMin": 15,
