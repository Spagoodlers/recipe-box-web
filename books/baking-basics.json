  {
   "id": "starter-baking-basics-sandwich-bread",
   "title": "Sandwich Bread",
   "description": "",
   "ingredients": [
    "3½ cups flour",
    "2 tsp instant yeast",
    "1½ tsp salt",
    "1 tbsp sugar",
    "1¼ cups warm milk",
    "2 tbsp melted butter"
   ],
   "steps": [
    "Mix everything into a dough. Knead for 10 minutes, until smooth and springy.",
    "Cover and leave to rise for 60 minutes, until doubled.",
    "Shape into a log and put it in a greased loaf pan. Rise again for 45 minutes.",
    "Heat the oven to 375°F. Bake for 35 minutes, until it sounds hollow when tapped underneath.",
    "Cool completely before slicing."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 170",
    "Protein: 4 g",
    "Fat: 3 g",
    "Carbohydrate: 30 g",
    "Fiber: 1 g",
    "Sugar: 2 g",
    "Sodium: 310 mg"
   ],
   "servings": 12,
   "yieldText": "1 loaf",
