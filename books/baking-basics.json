  {
   "id": "starter-baking-basics-fudgy-brownies",
   "title": "Fudgy Brownies",
   "description": "",
   "ingredients": [
    "½ cup butter",
    "1 cup sugar",
    "2 eggs",
    "1 tsp vanilla",
    "⅓ cup cocoa powder",
    "½ cup flour",
    "¼ tsp salt",
    "¼ tsp baking powder"
   ],
   "steps": [
    "Heat the oven to 350°F. Grease an 8-inch square pan.",
    "Melt the butter. Stir in the sugar, eggs and vanilla.",
    "Beat in the cocoa, flour, salt and baking powder.",
    "Spread in the pan. Bake for 25 minutes.",
    "Cool before cutting."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 130",
    "Protein: 2 g",
    "Fat: 7 g",
    "Carbohydrate: 17 g",
