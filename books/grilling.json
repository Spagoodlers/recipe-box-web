  {
   "id": "starter-grilling-classic-burgers",
   "title": "Classic Burgers",
   "description": "",
   "ingredients": [
    "1½ lb ground beef (80/20)",
    "1 tsp salt",
    "½ tsp black pepper",
    "4 slices cheddar",
    "4 burger buns",
    "lettuce, tomato and onion, to serve"
   ],
   "steps": [
    "Heat the grill to high. Shape the beef into 4 patties a little wider than the buns. Press a dent in the middle of each.",
    "Season both sides with the salt and pepper.",
    "Grill for 4 minutes, flip, add the cheddar and grill 4 minutes more, until the middle reads 160°F. Ground beef should always be cooked through.",
    "Toast the buns on the grill for the last minute. Build the burgers with the lettuce, tomato and onion."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 660",
    "Protein: 39 g",
    "Fat: 43 g",
    "Carbohydrate: 26 g",
    "Fiber: 1 g",
    "Sugar: 3 g",
    "Sodium: 1070 mg"
   ],
   "servings": 4,
   "yieldText": "4 servings",
