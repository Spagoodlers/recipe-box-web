  {
   "id": "starter-grilling-grilled-chicken-thighs",
   "title": "Grilled Chicken Thighs",
   "description": "",
   "ingredients": [
    "2 lb boneless chicken thighs",
    "3 tbsp olive oil",
    "2 cloves garlic, grated",
    "1 tsp smoked paprika",
    "1 tsp salt",
    "½ tsp black pepper",
    "1 lemon"
   ],
   "steps": [
    "Mix the oil, garlic, paprika, salt, pepper and the lemon's zest and juice. Coat the chicken and leave 20 minutes.",
    "Heat the grill to medium-high. Grill the thighs for 6 minutes per side, until they read 175°F.",
    "Rest for 5 minutes before serving."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 500",
    "Protein: 43 g",
    "Fat: 35 g",
