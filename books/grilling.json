  {
   "id": "starter-grilling-grilled-corn",
   "title": "Grilled Corn",
   "description": "",
   "ingredients": [
    "4 ears corn, husked",
    "2 tbsp butter, melted",
    "½ tsp salt",
    "1 lime",
    "a pinch of chili powder"
   ],
   "steps": [
    "Heat the grill to medium-high.",
    "Brush the corn with butter. Grill for 12 minutes, turning every few minutes, until charred in spots.",
    "Sprinkle with salt and chili powder. Squeeze the lime over."
   ],
   "notes": "",
   "nutrition": [
