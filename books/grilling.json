  {
   "id": "starter-grilling-barbecue-ribs",
   "title": "Barbecue Ribs",
   "description": "",
   "ingredients": [
    "2 racks baby back ribs",
    "2 tbsp brown sugar",
    "1 tbsp smoked paprika",
    "1 tsp garlic powder",
    "1 tsp salt",
    "½ tsp black pepper",
    "1 cup barbecue sauce"
   ],
   "steps": [
    "Heat the oven to 300°F. Pull the thin skin off the back of the ribs.",
    "Mix the sugar and spices and rub all over the ribs. Wrap each rack tightly in foil.",
    "Bake for 2 hours, until tender.",
    "Unwrap, brush with the sauce and grill over medium heat for 10 minutes, turning and brushing, until sticky."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 950",
    "Protein: 45 g",
    "Fat: 66 g",
    "Carbohydrate: 36 g",
    "Fiber: 1 g",
