  {
   "id": "starter-grilling-grilled-salmon",
   "title": "Grilled Salmon",
   "description": "",
   "ingredients": [
    "4 salmon fillets, skin on",
    "1 tbsp olive oil",
    "½ tsp salt",
    "¼ tsp black pepper",
    "1 lemon, in wedges",
    "2 tbsp butter",
    "1 clove garlic, grated",
    "1 tbsp chopped dill"
   ],
   "steps": [
    "Heat the grill to medium-high and oil the grates well.",
    "Brush the salmon with oil and season. Grill skin-side down for 6 minutes, then flip for 3 minutes.",
    "Melt the butter with the garlic and dill. Spoon over the salmon. Serve with lemon."
   ],
   "notes": "",
