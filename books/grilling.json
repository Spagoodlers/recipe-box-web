  {
   "id": "starter-grilling-steak-with-chimichurri",
   "title": "Steak with Chimichurri",
   "description": "",
   "ingredients": [
    "2 lb flank or skirt steak",
    "1½ tsp salt",
    "½ tsp black pepper",
    "1 cup parsley, finely chopped",
    "2 cloves garlic, grated",
    "½ tsp red pepper flakes",
    "3 tbsp red wine vinegar",
    "½ cup olive oil"
   ],
   "steps": [
    "Season the steak with 1 tsp of the salt and the pepper.",
    "Stir the parsley, garlic, pepper flakes, vinegar, oil and the rest of the salt together.",
    "Grill the steak over high heat for 4 minutes per side, until the thickest part reads 130°F for medium-rare (145°F for medium).",
    "Rest for 10 minutes, slice thinly across the grain, and spoon the chimichurri over."
   ],
   "notes": "",
