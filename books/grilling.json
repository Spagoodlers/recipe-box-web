  {
   "id": "starter-grilling-grilled-vegetables",
   "title": "Grilled Vegetables",
   "description": "",
   "ingredients": [
    "2 zucchini, in long slices",
    "1 eggplant, in rounds",
    "2 peppers, in quarters",
    "1 red onion, in thick rounds",
    "¼ cup olive oil",
    "1 tsp salt",
    "2 tbsp balsamic vinegar",
    "a handful of basil"
   ],
   "steps": [
    "Heat the grill to medium-high. Toss the vegetables with the oil and salt.",
    "Grill for 12 minutes, turning once, until tender and marked.",
    "Pile onto a platter, drizzle with the vinegar and scatter the basil."
   ],
