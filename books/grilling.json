  {
   "id": "starter-grilling-chicken-kebabs",
   "title": "Chicken Kebabs",
   "description": "",
   "ingredients": [
    "1½ lb chicken breast, in 1-inch cubes",
    "¼ cup plain yogurt",
    "2 tbsp olive oil",
    "2 cloves garlic, grated",
    "1 tsp cumin",
    "1 tsp paprika",
    "1 tsp salt",
    "1 red pepper, in chunks",
    "1 red onion, in chunks"
   ],
   "steps": [
    "Mix the yogurt, oil, garlic, spices and salt. Stir in the chicken and leave 30 minutes (or overnight).",
    "Thread the chicken, pepper and onion onto skewers.",
    "Grill over medium-high heat for 12 minutes, turning, until the chicken is cooked through."
   ],
   "notes": "",
