  {
   "id": "starter-vegetarian-bean-burritos",
   "title": "Bean Burritos",
   "description": "",
   "ingredients": [
    "2 cans pinto beans, drained",
    "1 tsp ground cumin",
    "1 tsp chili powder",
    "1 cup cooked rice",
    "1 cup grated cheese",
    "4 large tortillas",
    "salsa"
   ],
   "steps": [
    "Warm the beans with the spices for 5 minutes. Mash lightly.",
    "Fill the tortillas with beans, rice, cheese and salsa. Roll up.",
    "Toast seam-side down in a dry pan for 2 minutes per side."
   ],
   "notes": "",
