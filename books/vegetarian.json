  {
   "id": "starter-vegetarian-tofu-stir-fry",
   "title": "Tofu Stir-Fry",
   "description": "",
   "ingredients": [
    "14 oz firm tofu, pressed and cubed",
    "2 tbsp oil",
    "1 bell pepper, sliced",
    "1 cup snap peas",
    "2 cloves garlic, minced",
    "3 tbsp soy sauce",
    "1 tbsp honey",
    "1 tsp cornstarch mixed with 2 tbsp water"
   ],
   "steps": [
    "Fry the tofu in the oil for 8 minutes, turning, until golden. Lift it out.",
    "Stir-fry the pepper and snap peas for 3 minutes.",
    "Add the garlic for 30 seconds.",
    "Return the tofu with the soy sauce, honey and cornstarch mix. Toss for 1 minute."
   ],
   "notes": "",
