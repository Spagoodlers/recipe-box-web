  {
   "id": "starter-vegetarian-mushroom-risotto",
   "title": "Mushroom Risotto",
   "description": "",
   "ingredients": [
    "4 cups vegetable stock",
    "2 tbsp butter",
    "1 onion, finely chopped",
    "8 oz mushrooms, sliced",
    "1½ cups arborio rice",
    "½ cup white wine (optional)",
    "½ cup grated parmesan",
    "salt and pepper"
   ],
   "steps": [
    "Keep the stock hot in a pan.",
    "Cook the onion and mushrooms in the butter for 5 minutes.",
    "Stir in the rice for 1 minute. Add the wine and stir until absorbed.",
    "Add the stock a ladle at a time, stirring, letting each be absorbed. About 20 minutes, until creamy and just tender.",
    "Off the heat, stir in the parmesan. Season."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 420",
    "Protein: 13 g",
    "Fat: 11 g",
