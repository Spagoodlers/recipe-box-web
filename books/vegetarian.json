   "id": "starter-vegetarian-chickpea-curry",
   "title": "Chickpea Curry",
   "description": "",
   "ingredients": [
    "1 tbsp oil",
    "1 onion, chopped",
    "2 cloves garlic",
    "1 tbsp grated ginger",
    "2 tbsp curry powder",
    "1 can (14 oz) chopped tomatoes",
    "1 can (14 oz) coconut milk",
    "2 cans chickpeas, drained",
    "2 cups spinach",
    "salt",
    "rice, to serve"
   ],
   "steps": [
    "Soften the onion in the oil for 5 minutes.",
    "Add the garlic, ginger and curry powder for 1 minute.",
    "Add the tomatoes, coconut milk and chickpeas. Simmer for 15 minutes.",
    "Stir in the spinach until wilted. Season and serve with rice."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 430",
    "Protein: 14 g",
    "Fat: 25 g",
