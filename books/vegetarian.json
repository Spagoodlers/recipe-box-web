  {
   "id": "starter-vegetarian-red-lentil-dal",
   "title": "Red Lentil Dal",
   "description": "",
   "ingredients": [
    "1 cup red lentils, rinsed",
    "3 cups water",
    "1 tsp turmeric",
    "1 tsp salt",
    "2 tbsp butter or oil",
    "1 tsp cumin seeds",
    "1 onion, chopped",
    "2 cloves garlic",
    "1 tbsp grated ginger",
    "1 tomato, chopped",
    "cilantro"
   ],
   "steps": [
    "Simmer the lentils, water and turmeric for 20 minutes, until soft.",
    "Meanwhile, fry the cumin seeds in the butter for 30 seconds.",
    "Add the onion for 5 minutes, then the garlic, ginger and tomato for 3 minutes.",
    "Stir everything into the lentils with the salt. Top with cilantro."
   ],
   "notes": "",
   "nutrition": [
