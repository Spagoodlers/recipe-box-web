   "id": "starter-vegetarian-veggie-chili",
   "title": "Veggie Chili",
   "description": "",
   "ingredients": [
    "1 tbsp oil",
    "1 onion, chopped",
    "1 bell pepper, chopped",
    "2 cloves garlic",
    "2 tbsp chili powder",
    "1 tsp ground cumin",
    "1 can (28 oz) chopped tomatoes",
    "2 cans beans, drained",
