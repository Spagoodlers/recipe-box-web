   "id": "starter-vegetarian-roasted-cauliflower",
   "title": "Roasted Cauliflower",
   "description": "",
   "ingredients": [
    "1 head cauliflower, in florets",
    "3 tbsp olive oil",
    "1 tsp ground cumin",
    "1 tsp paprika",
    "½ tsp salt"
   ],
   "steps": [
    "Heat the oven to 425°F.",
    "Toss the cauliflower with everything else on a tray.",
    "Roast for 30 minutes, turning once, until browned."
   ],
