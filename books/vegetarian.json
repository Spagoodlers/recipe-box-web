  {
   "id": "starter-vegetarian-tomato-mozzarella-pasta",
   "title": "Tomato Mozzarella Pasta",
   "description": "",
   "ingredients": [
    "8 oz pasta",
    "2 cups cherry tomatoes, halved",
    "2 cloves garlic, sliced",
    "3 tbsp olive oil",
    "4 oz mozzarella, cubed",
    "a handful of basil",
    "salt"
   ],
   "steps": [
    "Cook the pasta in salted boiling water.",
    "Meanwhile, cook the tomatoes and garlic in the oil for 5 minutes, until they start to burst.",
    "Toss with the drained pasta, mozzarella and basil. Season."
   ],
   "notes": "",
