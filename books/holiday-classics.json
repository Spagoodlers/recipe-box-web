  {
   "id": "starter-holiday-classics-cranberry-sauce",
   "title": "Cranberry Sauce",
   "description": "",
   "ingredients": [
    "12 oz fresh cranberries",
    "1 cup sugar",
    "1 cup orange juice",
    "1 tsp orange zest"
   ],
   "steps": [
    "Put the sugar and orange juice in a pan. Bring to a boil.",
    "Add the cranberries and zest. Simmer for 10 minutes, until most have burst.",
    "Cool. It thickens as it cools."
   ],
   "notes": "",
