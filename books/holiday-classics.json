  {
   "id": "starter-holiday-classics-gingerbread-cookies",
   "title": "Gingerbread Cookies",
   "description": "",
   "ingredients": [
    "3 cups flour",
    "1 tbsp ground ginger",
    "1 tsp cinnamon",
    "¼ tsp ground cloves",
    "1 tsp baking soda",
    "¼ tsp salt",
    "¾ cup butter, softened",
    "¾ cup brown sugar",
    "1 egg",
    "½ cup molasses"
   ],
   "steps": [
    "Mix the flour, spices, baking soda and salt.",
    "Beat the butter and sugar until fluffy. Beat in the egg and molasses.",
    "Stir in the dry mix. Wrap the dough and chill for 1 hour.",
    "Heat the oven to 350°F. Roll out ¼ inch thick and cut shapes.",
    "Bake for 10 minutes. Cool on a rack before icing."
   ],
   "notes": "",
