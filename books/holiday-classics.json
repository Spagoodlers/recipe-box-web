  {
   "id": "starter-holiday-classics-pumpkin-pie",
   "title": "Pumpkin Pie",
   "description": "",
   "ingredients": [
    "1 unbaked 9-inch pie crust",
    "1 can (15 oz) pumpkin purée",
    "¾ cup sugar",
    "2 eggs",
    "1 can (12 oz) evaporated milk",
    "1 tsp cinnamon",
    "½ tsp ground ginger",
    "¼ tsp ground cloves",
    "½ tsp salt"
   ],
   "steps": [
    "Heat the oven to 425°F.",
    "Whisk everything except the crust until smooth. Pour into the crust.",
    "Bake for 15 minutes. Lower the oven to 350°F and bake 40 minutes more, until a knife comes out clean.",
    "Cool for 2 hours before slicing."
   ],
   "notes": "",
