  {
   "id": "starter-holiday-classics-green-bean-casserole",
   "title": "Green Bean Casserole",
   "description": "",
   "ingredients": [
    "1½ lb green beans, trimmed and halved",
    "1 can (10.5 oz) cream of mushroom soup",
    "¾ cup milk",
    "1 tsp soy sauce",
    "black pepper",
    "1⅓ cups crispy fried onions"
   ],
   "steps": [
    "Heat the oven to 350°F.",
    "Boil the beans for 5 minutes. Drain.",
    "Mix the soup, milk, soy sauce and pepper. Stir in the beans and half the onions.",
    "Bake for 25 minutes. Top with the rest of the onions and bake 5 minutes more."
   ],
   "notes": "",
   "nutrition": [
