  {
   "id": "starter-holiday-classics-bread-stuffing",
   "title": "Bread Stuffing",
   "description": "",
   "ingredients": [
    "1 loaf day-old bread, in cubes (about 12 cups)",
    "½ cup butter",
    "1 onion, chopped",
    "3 celery sticks, chopped",
    "2 tsp dried sage",
    "1 tsp dried thyme",
    "1 tsp salt",
    "½ tsp black pepper",
    "2 eggs",
    "2 cups chicken stock"
   ],
   "steps": [
    "Heat the oven to 350°F. Butter a large baking dish.",
    "Melt the butter. Cook the onion and celery for 8 minutes, until soft. Stir in the herbs, salt and pepper.",
    "Toss with the bread. Whisk the eggs and stock and pour over.",
    "Spread in the dish. Cover with foil and bake for 25 minutes, then uncover and bake 20 minutes more."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 230",
    "Protein: 6 g",
    "Fat: 12 g",
    "Carbohydrate: 24 g",
