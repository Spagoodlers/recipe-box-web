  {
   "id": "starter-holiday-classics-roast-turkey",
   "title": "Roast Turkey",
   "description": "",
   "ingredients": [
    "1 turkey (12 to 14 lb), thawed",
    "½ cup butter, softened",
    "2 tsp salt",
    "1 tsp black pepper",
    "1 onion, quartered",
    "1 lemon, halved",
    "a few sprigs thyme and sage"
   ],
   "steps": [
    "Heat the oven to 325°F. Take out the neck and giblets. Pat the turkey dry.",
    "Rub the butter, salt and pepper all over. Put the onion, lemon and herbs inside.",
    "Roast for 3 hours, until the thickest part of the thigh reads 165°F. Cover loosely with foil if it browns too fast.",
    "Rest for 30 minutes before carving."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 470",
    "Protein: 49 g",
    "Fat: 27 g",
    "Carbohydrate: 2 g",
    "Fiber: 0 g",
    "Sugar: 1 g",
    "Sodium: 590 mg"
   ],
   "servings": 12,
