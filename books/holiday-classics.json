  {
   "id": "starter-holiday-classics-sweet-potato-casserole",
   "title": "Sweet Potato Casserole",
   "description": "",
   "ingredients": [
    "3 lb sweet potatoes",
    "½ cup brown sugar",
    "4 tbsp butter, melted",
    "2 eggs",
    "1 tsp vanilla extract",
    "½ tsp salt",
    "## Topping",
    "1 cup chopped pecans",
    "½ cup brown sugar",
    "¼ cup flour",
    "3 tbsp butter, melted"
   ],
   "steps": [
    "Heat the oven to 400°F. Bake the sweet potatoes for 45 minutes, until soft. Lower the oven to 350°F.",
    "Scoop out the flesh and mash with the sugar, butter, eggs, vanilla and salt. Spread in a baking dish.",
    "Mix the topping and scatter it over.",
    "Bake for 25 minutes."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 470",
    "Protein: 6 g",
    "Fat: 21 g",
    "Carbohydrate: 66 g",
    "Fiber: 7 g",
