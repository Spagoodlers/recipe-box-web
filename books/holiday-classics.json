  {
   "id": "starter-holiday-classics-turkey-gravy",
   "title": "Turkey Gravy",
   "description": "",
   "ingredients": [
    "pan drippings from the turkey",
    "¼ cup flour",
    "3 cups turkey or chicken stock",
    "salt and pepper"
   ],
   "steps": [
    "Pour off all but ¼ cup of fat from the roasting pan.",
    "Set the pan over medium heat. Whisk in the flour and cook for 2 minutes.",
    "Whisk in the stock slowly. Simmer for 8 minutes, until thick. Season."
   ],
   "notes": "",
