  {
   "id": "starter-holiday-classics-glazed-ham",
   "title": "Glazed Ham",
   "description": "",
   "ingredients": [
    "1 bone-in spiral ham (8 lb)",
    "½ cup brown sugar",
    "¼ cup honey",
    "2 tbsp Dijon mustard",
    "¼ tsp ground cloves"
   ],
   "steps": [
    "Heat the oven to 325°F. Put the ham cut-side down in a roasting pan. Cover with foil.",
    "Bake for 90 minutes.",
    "Simmer the sugar, honey, mustard and cloves for 2 minutes.",
    "Uncover the ham, brush with the glaze and bake 30 minutes more, glazing twice."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 400",
