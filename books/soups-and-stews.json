   "id": "starter-soups-and-stews-butternut-squash-soup",
   "title": "Butternut Squash Soup",
   "description": "",
   "ingredients": [
    "2 tbsp butter",
    "1 onion, chopped",
    "1 butternut squash, peeled and cubed",
    "4 cups stock",
    "½ tsp nutmeg",
    "½ cup cream",
    "salt"
   ],
   "steps": [
    "Soften the onion in the butter for 5 minutes.",
    "Add the squash and stock. Simmer for 25 minutes, until tender.",
    "Blend until smooth. Stir in the nutmeg and cream. Season."
   ],
   "notes": "",
