   "id": "starter-soups-and-stews-chicken-tortilla-soup",
   "title": "Chicken Tortilla Soup",
   "description": "",
   "ingredients": [
    "1 tbsp oil",
    "1 onion, chopped",
    "2 cloves garlic",
    "1 tsp ground cumin",
    "1 tsp chili powder",
    "1 can (14 oz) chopped tomatoes",
    "6 cups chicken stock",
    "2 cups cooked shredded chicken",
    "1 can (14 oz) black beans, drained",
    "1 cup corn",
    "tortilla chips, lime and avocado, to serve"
   ],
   "steps": [
    "Soften the onion in the oil for 5 minutes.",
    "Add the garlic and spices for 1 minute.",
    "Add the tomatoes and stock. Simmer for 15 minutes.",
    "Add the chicken, beans and corn. Simmer 5 minutes more.",
    "Serve with chips, lime and avocado."
   ],
