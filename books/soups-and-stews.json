  {
   "id": "starter-soups-and-stews-french-onion-soup",
   "title": "French Onion Soup",
   "description": "",
   "ingredients": [
    "4 tbsp butter",
    "4 large onions, thinly sliced",
    "1 tsp sugar",
    "2 tbsp flour",
    "6 cups beef stock",
    "1 bay leaf",
    "4 slices baguette",
    "1 cup grated Gruyère"
   ],
   "steps": [
    "Cook the onions in the butter over medium-low heat for 40 minutes, stirring often, until deep brown. Add the sugar halfway.",
    "Stir in the flour for 1 minute.",
    "Add the stock and bay leaf. Simmer for 15 minutes.",
    "Ladle into ovenproof bowls. Top with the bread and cheese.",
    "Broil for 3 minutes, until bubbling."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 420",
