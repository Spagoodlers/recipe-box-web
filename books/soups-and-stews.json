   "id": "starter-soups-and-stews-irish-stew",
   "title": "Irish Stew",
   "description": "",
   "ingredients": [
    "2 lb lamb shoulder, in chunks",
    "2 onions, sliced",
    "3 carrots, in chunks",
    "4 cups stock",
    "1 tsp dried thyme",
    "2 lb potatoes, in chunks",
    "salt and pepper"
   ],
   "steps": [
    "Put the lamb, onions, carrots, stock and thyme in a heavy pot. Season.",
    "Bring to a boil, then cover and simmer gently for 60 minutes.",
    "Add the potatoes. Simmer 45 minutes more, until the lamb is tender."
   ],
   "notes": "",
