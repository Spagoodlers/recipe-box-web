  {
   "id": "starter-soups-and-stews-split-pea-soup",
   "title": "Split Pea Soup",
   "description": "",
   "ingredients": [
    "2 cups dried split peas, rinsed",
    "1 ham hock or 1 cup diced ham",
    "1 onion, chopped",
    "2 carrots, chopped",
    "2 celery sticks, chopped",
    "8 cups water",
    "1 bay leaf",
    "salt and pepper"
   ],
   "steps": [
    "Put everything in a large pot. Bring to a boil.",
    "Simmer, partly covered, for 90 minutes, until the peas break down.",
    "Lift out the ham hock, shred the meat and stir it back in. Season."
   ],
