   "id": "starter-soups-and-stews-minestrone",
   "title": "Minestrone",
   "description": "",
   "ingredients": [
    "2 tbsp olive oil",
    "1 onion, chopped",
    "2 carrots, chopped",
    "2 celery sticks, chopped",
    "2 cloves garlic",
    "1 zucchini, diced",
    "1 can (14 oz) chopped tomatoes",
    "6 cups stock",
    "1 can (14 oz) white beans, drained",
    "1 cup small pasta",
    "a handful of spinach",
    "parmesan, to serve"
   ],
   "steps": [
    "Soften the onion, carrots and celery in the oil for 5 minutes.",
    "Add the garlic and zucchini for 2 minutes.",
    "Add the tomatoes and stock. Simmer for 15 minutes.",
    "Add the beans and pasta. Cook for 10 minutes.",
    "Stir in the spinach. Serve with parmesan."
   ],
   "notes": "",
