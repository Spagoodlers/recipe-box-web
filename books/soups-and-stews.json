   "id": "starter-soups-and-stews-potato-leek-soup",
   "title": "Potato Leek Soup",
   "description": "",
   "ingredients": [
    "2 tbsp butter",
    "3 leeks, sliced and washed",
    "1½ lb potatoes, diced",
    "4 cups stock",
    "½ cup cream",
    "salt and pepper"
   ],
   "steps": [
    "Soften the leeks in the butter for 8 minutes without browning.",
    "Add the potatoes and stock. Simmer for 20 minutes.",
    "Blend until smooth. Stir in the cream and season."
   ],
   "notes": "",
