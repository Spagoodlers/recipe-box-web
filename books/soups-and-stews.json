   "id": "starter-soups-and-stews-lentil-soup",
   "title": "Lentil Soup",
   "description": "",
   "ingredients": [
    "2 tbsp olive oil",
    "1 onion, chopped",
    "2 carrots, chopped",
    "2 celery sticks, chopped",
    "2 cloves garlic",
    "1 tsp ground cumin",
    "1½ cups dried lentils, rinsed",
    "1 can (14 oz) chopped tomatoes",
    "6 cups stock",
    "salt",
    "1 lemon"
   ],
   "steps": [
    "Soften the onion, carrots and celery in the oil for 5 minutes.",
    "Add the garlic and cumin for 1 minute.",
    "Add the lentils, tomatoes and stock. Simmer for 30 minutes, until the lentils are soft.",
    "Season and squeeze in the lemon."
   ],
   "notes": "",
