  {
   "id": "starter-slow-cooker-slow-cooker-beef-stroganoff",
   "title": "Slow Cooker Beef Stroganoff",
   "description": "",
   "ingredients": [
    "2 lb beef chuck, in strips",
    "1 onion, sliced",
    "8 oz mushrooms, sliced",
    "2 cloves garlic",
    "1 cup beef stock",
    "1 tbsp Worcestershire sauce",
    "1 tsp salt",
    "1 cup sour cream",
    "2 tbsp flour",
    "egg noodles, to serve"
   ],
   "steps": [
    "Put the beef, onion, mushrooms, garlic, stock, Worcestershire and salt in the slow cooker.",
    "Cook on low for 8 hours, until the beef is tender enough to cut with a spoon.",
    "Mix the sour cream and flour. Stir it in and cook 30 minutes more.",
    "Serve over egg noodles."
   ],
   "notes": "",
