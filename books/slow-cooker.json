  {
   "id": "starter-slow-cooker-slow-cooker-pulled-pork",
   "title": "Slow Cooker Pulled Pork",
   "description": "",
   "ingredients": [
    "4 lb pork shoulder",
    "1 tbsp brown sugar",
    "2 tsp paprika",
    "1 tsp garlic powder",
    "1 tsp salt",
    "½ tsp black pepper",
    "1 onion, sliced",
    "½ cup chicken stock",
    "1 cup barbecue sauce"
   ],
   "steps": [
    "Mix the sugar, paprika, garlic powder, salt and pepper. Rub all over the pork.",
    "Put the onion and stock in the slow cooker. Set the pork on top.",
    "Cook on low for 8 hours, until it pulls apart easily with a fork (about 195°F).",
    "Shred with two forks. Stir in the barbecue sauce."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 520",
    "Protein: 33 g",
