   "title": "Slow Cooker Butter Chicken",
   "description": "",
   "ingredients": [
    "2 lb chicken thighs, in chunks",
    "1 onion, chopped",
    "3 cloves garlic",
    "1 tbsp grated ginger",
    "2 tbsp garam masala",
    "1 tsp turmeric",
    "1 tsp salt",
    "1 can (14 oz) tomato sauce",
    "½ cup heavy cream",
    "2 tbsp butter",
    "rice, to serve"
   ],
   "steps": [
    "Put everything except the cream and butter in the slow cooker.",
    "Cook on low for 4 hours, until the chicken is tender and reads 165°F.",
    "Stir in the cream and butter. Serve with rice."
