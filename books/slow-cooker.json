  {
   "id": "starter-slow-cooker-slow-cooker-chicken-tortilla-soup",
   "title": "Slow Cooker Chicken Tortilla Soup",
   "description": "",
   "ingredients": [
    "1½ lb chicken thighs",
    "1 onion, chopped",
    "1 can (15 oz) black beans, drained",
    "1 cup frozen corn",
    "1 can (14 oz) diced tomatoes",
    "4 cups chicken stock",
    "1 tsp cumin",
    "1 tsp chili powder",
    "1 tsp salt",
    "tortilla chips, to serve",
    "1 lime"
   ],
   "steps": [
    "Put everything except the chips and lime in the slow cooker.",
    "Cook on low for 6 hours, until the chicken shreds easily and reads 165°F.",
    "Shred the chicken in the pot. Squeeze in the lime.",
    "Serve over crushed tortilla chips."
   ],
