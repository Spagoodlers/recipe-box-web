  {
   "id": "starter-slow-cooker-slow-cooker-chili",
   "title": "Slow Cooker Chili",
   "description": "",
   "ingredients": [
    "2 lb ground beef",
    "1 onion, chopped",
    "2 cloves garlic",
    "2 cans (15 oz) kidney beans, drained",
    "1 can (28 oz) crushed tomatoes",
    "2 tbsp chili powder",
    "1 tsp cumin",
    "1 tsp salt"
   ],
   "steps": [
    "Brown the beef with the onion and garlic in a pan until no pink remains. Drain the fat.",
    "Put everything in the slow cooker and stir.",
    "Cook on low for 6 hours."
   ],
   "notes": "",
