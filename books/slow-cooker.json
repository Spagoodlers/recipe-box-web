   "id": "starter-slow-cooker-slow-cooker-lentil-soup",
   "title": "Slow Cooker Lentil Soup",
   "description": "",
   "ingredients": [
    "1½ cups brown lentils, rinsed",
    "1 onion, chopped",
    "2 carrots, diced",
    "2 celery sticks, diced",
    "2 cloves garlic",
    "1 can (14 oz) diced tomatoes",
    "6 cups vegetable stock",
    "1 tsp cumin",
    "1 tsp salt",
    "2 cups spinach"
   ],
   "steps": [
    "Put everything except the spinach in the slow cooker.",
    "Cook on low for 8 hours, until the lentils are soft and falling apart.",
    "Stir in the spinach until it wilts."
