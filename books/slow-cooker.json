   "id": "starter-slow-cooker-slow-cooker-pot-roast",
   "title": "Slow Cooker Pot Roast",
   "description": "",
   "ingredients": [
    "3 lb beef chuck roast",
    "1 tsp salt",
    "½ tsp black pepper",
    "1 lb small potatoes",
    "4 carrots, in chunks",
    "1 onion, quartered",
    "1 cup beef stock",
    "2 sprigs rosemary"
   ],
   "steps": [
    "Season the beef with the salt and pepper.",
    "Put the potatoes, carrots and onion in the slow cooker. Set the beef on top.",
    "Pour in the stock and add the rosemary.",
    "Cook on low for 8 hours, until the beef is very tender."
   ],
