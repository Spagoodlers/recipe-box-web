  {
   "id": "starter-cooking-with-kids-banana-pancakes",
   "title": "Banana Pancakes",
   "description": "",
   "ingredients": [
    "1 ripe banana",
    "2 eggs",
    "¼ cup flour",
    "½ tsp baking powder",
    "a pinch of cinnamon",
    "butter, for the pan"
   ],
   "steps": [
    "Mash the banana in a bowl with a fork until smooth.",
    "Crack in the eggs and whisk. Stir in the flour, baking powder and cinnamon.",
    "A grown-up heats a buttered pan over medium heat. Pour in small circles of batter.",
    "Cook for 2 minutes, flip, and cook 1 minute more."
   ],
   "notes": "",
