   "id": "starter-cooking-with-kids-no-bake-energy-bites",
   "title": "No-Bake Energy Bites",
   "description": "",
   "ingredients": [
    "1 cup rolled oats",
    "½ cup peanut butter",
    "⅓ cup honey",
    "½ cup mini chocolate chips",
    "2 tbsp ground flaxseed",
    "1 tsp vanilla"
   ],
   "steps": [
