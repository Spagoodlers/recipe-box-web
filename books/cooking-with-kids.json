  {
   "id": "starter-cooking-with-kids-rice-krispie-treats",
   "title": "Rice Krispie Treats",
   "description": "",
   "ingredients": [
    "3 tbsp butter",
    "1 bag (10 oz) marshmallows",
    "6 cups crispy rice cereal"
   ],
   "steps": [
    "Butter a 9×13 pan.",
    "A grown-up melts the butter in a big pot over low heat, then stirs in the marshmallows until smooth, about 3 minutes.",
    "Take off the heat. Stir in the cereal until coated.",
    "Press into the pan with buttered hands or a spatula. Cool, then cut into squares."
   ],
   "notes": "",
