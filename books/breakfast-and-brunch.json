   "id": "starter-breakfast-and-brunch-hash-browns",
   "title": "Hash Browns",
   "description": "",
   "ingredients": [
    "2 large potatoes, peeled and grated",
    "½ tsp salt",
    "2 tbsp oil"
   ],
   "steps": [
