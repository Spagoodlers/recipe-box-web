   "id": "starter-breakfast-and-brunch-granola",
   "title": "Granola",
   "description": "",
   "ingredients": [
    "3 cups rolled oats",
    "1 cup nuts, chopped",
    "½ tsp salt",
    "½ tsp cinnamon",
    "⅓ cup honey or maple syrup",
    "⅓ cup oil",
    "½ cup dried fruit"
   ],
   "steps": [
    "Heat the oven to 325°F.",
    "Mix everything except the dried fruit. Spread on a lined tray.",
    "Bake for 25 minutes, stirring halfway, until golden.",
    "Stir in the fruit. It crisps up as it cools."
