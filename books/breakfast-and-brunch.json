   "id": "starter-breakfast-and-brunch-french-toast",
   "title": "French Toast",
   "description": "",
   "ingredients": [
    "2 eggs",
    "½ cup milk",
    "½ tsp cinnamon",
    "1 tsp vanilla",
    "4 slices bread",
    "1 tbsp butter",
    "maple syrup, to serve"
   ],
   "steps": [
    "Whisk the eggs, milk, cinnamon and vanilla in a shallow dish.",
    "Dip each slice of bread for a few seconds per side.",
    "Cook in the butter over medium heat for 3 minutes per side, until golden.",
    "Serve with maple syrup."
   ],
   "notes": "",
