   "id": "starter-breakfast-and-brunch-waffles",
   "title": "Waffles",
   "description": "",
   "ingredients": [
    "2 cups flour",
    "2 tbsp sugar",
    "1 tbsp baking powder",
    "½ tsp salt",
    "1¾ cups milk",
    "2 eggs",
    "½ cup melted butter"
   ],
   "steps": [
    "Heat the waffle iron.",
    "Whisk the dry ingredients. Whisk in the milk, eggs and butter until just smooth.",
    "Cook in the iron, about 4 minutes each, until crisp."
   ],
