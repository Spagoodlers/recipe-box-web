  {
   "id": "starter-party-food-seven-layer-dip",
   "title": "Seven-Layer Dip",
   "description": "",
   "ingredients": [
    "1 can (16 oz) refried beans",
    "1 tbsp taco seasoning",
    "1 cup sour cream",
    "1 cup guacamole",
    "1 cup salsa",
    "1½ cups shredded cheddar",
    "2 tomatoes, diced",
    "3 green onions, sliced",
    "¼ cup sliced black olives"
   ],
   "steps": [
    "Stir the taco seasoning into the beans and spread in a shallow dish.",
    "Layer on the sour cream, guacamole, salsa and cheddar.",
    "Top with the tomatoes, green onions and olives. Chill until serving."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 250",
    "Protein: 8 g",
