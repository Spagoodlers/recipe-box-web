  {
   "id": "starter-party-food-spinach-artichoke-dip",
   "title": "Spinach Artichoke Dip",
   "description": "",
   "ingredients": [
    "8 oz cream cheese, softened",
    "½ cup sour cream",
    "¼ cup mayonnaise",
    "1 cup grated parmesan",
    "1 cup shredded mozzarella",
    "10 oz frozen spinach, thawed and squeezed dry",
    "1 can (14 oz) artichoke hearts, drained and chopped",
    "1 clove garlic, grated"
   ],
   "steps": [
    "Heat the oven to 375°F.",
    "Mix everything except half the mozzarella. Spread in a small baking dish and top with the rest.",
    "Bake for 25 minutes, until bubbling and golden. Serve with chips or bread."
   ],
   "notes": "",
