   "id": "starter-party-food-guacamole",
   "title": "Guacamole",
   "description": "",
   "ingredients": [
    "3 ripe avocados",
    "1 lime",
    "½ small onion, finely chopped",
    "1 jalapeño, finely chopped",
    "a handful of cilantro, chopped",
    "½ tsp salt",
    "1 tomato, diced"
   ],
   "steps": [
    "Mash the avocados with the lime juice, leaving some chunks.",
    "Stir in the onion, jalapeño, cilantro, salt and tomato. Taste and add more salt or lime."
   ],
   "notes": "",
