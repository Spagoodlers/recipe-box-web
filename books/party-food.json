  {
   "id": "starter-party-food-buffalo-wings",
   "title": "Buffalo Wings",
   "description": "",
   "ingredients": [
    "2 lb chicken wings",
    "1 tbsp baking powder",
    "1 tsp salt",
    "½ cup hot sauce",
    "4 tbsp butter",
    "blue cheese dressing and celery, to serve"
   ],
   "steps": [
    "Heat the oven to 425°F. Pat the wings very dry and toss with the baking powder and salt.",
    "Spread on a rack over a baking sheet. Bake for 45 minutes, turning halfway, until crisp.",
    "Melt the butter with the hot sauce. Toss the wings in it. Serve with dressing and celery."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 380",
    "Protein: 25 g",
    "Fat: 31 g",
