  {
   "id": "starter-party-food-pigs-in-a-blanket",
   "title": "Pigs in a Blanket",
   "description": "",
   "ingredients": [
    "1 tube (8 oz) crescent roll dough",
    "24 cocktail sausages",
    "1 egg, beaten",
    "1 tsp sesame seeds",
    "mustard, to serve"
   ],
   "steps": [
    "Heat the oven to 375°F. Unroll the dough and cut each triangle into 3 thin strips.",
    "Roll a sausage up in each strip. Place seam-side down on a lined baking sheet.",
    "Brush with egg and sprinkle with sesame seeds. Bake for 15 minutes, until golden."
   ],
   "notes": "",
