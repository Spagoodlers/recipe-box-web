  {
   "id": "starter-party-food-deviled-eggs",
   "title": "Deviled Eggs",
   "description": "",
   "ingredients": [
    "6 eggs",
    "¼ cup mayonnaise",
    "1 tsp Dijon mustard",
    "1 tsp vinegar",
    "a pinch of salt",
    "paprika, to sprinkle"
   ],
   "steps": [
    "Cover the eggs with cold water, bring to a boil, then cover, turn off the heat and leave 12 minutes.",
    "Cool in ice water, peel and halve lengthwise.",
    "Mash the yolks with the mayonnaise, mustard, vinegar and salt until smooth.",
    "Spoon or pipe back into the whites. Sprinkle with paprika."
   ],
   "notes": "",
   "nutrition": [
    "Calories: 70",
    "Protein: 3 g",
