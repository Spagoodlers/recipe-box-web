   "id": "starter-party-food-caprese-skewers",
   "title": "Caprese Skewers",
   "description": "",
   "ingredients": [
    "24 cherry tomatoes",
    "24 small mozzarella balls",
    "24 basil leaves",
    "2 tbsp olive oil",
    "2 tbsp balsamic glaze",
    "salt and pepper"
   ],
   "steps": [
    "Thread a tomato, a basil leaf and a mozzarella ball onto each small skewer or toothpick.",
    "Arrange on a platter. Drizzle with the oil and balsamic glaze, and season."
   ],
